{
  "name": "gemini-finance-sheet",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run build && node scripts/deploy-cloudflare.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:share-regression": "node scripts/share-event-regression.mjs",
    "test:analytics-regression": "node scripts/analytics-regression.mjs",
    "test:export-regression": "node scripts/export-regression.mjs",
    "test:account-edit-regression": "node scripts/account-edit-regression.mjs",
    "test:transaction-crud-regression": "node scripts/transaction-crud-regression.mjs",
    "test:recurring-regression": "node scripts/recurring-regression.mjs",
    "test:event-summary-regression": "node scripts/event-summary-regression.mjs",
    "test:dashboard-summary-regression": "node scripts/dashboard-summary-regression.mjs",
    "cleanup:recurring-regressions": "node scripts/cleanup-recurring-regressions.mjs",
    "bundle:snapshot": "node scripts/bundle-snapshot.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "analyze": "vite build --mode analyze",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.22",
    "uqr": "^0.1.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
